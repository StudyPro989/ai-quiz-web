# Groq (OpenAI-compatible). Get key: https://console.groq.com
# NEVER commit a real key — copy this file to .env and server/.env and fill it in locally.
AI_API_KEY=
AI_MODEL=openai/gpt-oss-120b
# Gemini. Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Default provider (groq|gemini) + which providers the UI may offer
AI_PROVIDER=groq
ALLOWED_PROVIDERS=groq,gemini
ALLOWED_GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro
PORT=3001
# Comma-separated allowlist for model dropdown override
ALLOWED_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,openai/gpt-oss-safeguard-20b,qwen/qwen3.6-27b,qwen/qwen3.8-27b,groq/compound,groq/compound-mini,allam-2-7b
# Optional: restrict browser origins in production, e.g. https://yourdomain.com
ALLOWED_ORIGINS=
# Max quiz generations per IP per hour (abuse protection for your API key budget)
GEN_LIMIT_PER_HOUR=20
